<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="72dp"
        android:paddingTop="48dp"
        android:paddingRight="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="@string/hint_keys"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/row_source"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_source" />

            <TextView
                android:id="@+id/value_source"
                style="@style/SettingValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_edit"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/edit_source" />

            <TextView
                android:id="@+id/value_edit"
                style="@style/SettingValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_refresh"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_refresh" />

            <TextView
                android:id="@+id/value_refresh"
                style="@style/SettingValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_remember"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_remember" />

            <TextView
                android:id="@+id/value_remember"
                style="@style/SettingValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_about"
            style="@style/SettingRow">

            <TextView
                style="@style/SettingTitle"
                android:text="@string/settings_about" />

            <TextView
                android:id="@+id/value_about"
                style="@style/SettingValue" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
